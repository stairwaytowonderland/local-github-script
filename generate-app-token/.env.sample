# dotenv-linter:off IncorrectDelimiter

# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# GitHub APP Custom Variables

# GitHub App ID of the GitHub App for which the token will be generated.
APP_ID=
# Path to the private key file of the GitHub App for which the token will be generated, e.g. '/path/to/private-key.pem'.
APP_PRIVATE_KEY_PATH=
# GitHub App installation ID of the GitHub App for which the token will be generated.
APP_INSTALLATION_ID=
# GitHub App slug of the GitHub App for which the token will be generated.
APP_SLUG=

# GitHub Default Variables
# https://docs.github.com/en/actions/reference/workflows-and-actions/variables

# GitHub server URL for the GitHub instance where the GitHub App is installed.
GITHUB_SERVER_URL='https://github.com'
# GitHub username of the user who will be used to generate the GitHub App token.
GITHUB_ACTOR=
# GitHub username of the owner of the repository where the GitHub App is installed.
GITHUB_REPOSITORY_OWNER=
